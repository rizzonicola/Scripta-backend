# Copiare in .env (non committare) e valorizzare. Nessun default è accettato.
# Generare un segreto:  openssl rand -base64 48
JWT_SECRET=
ADMIN_USER=
ADMIN_PASS=
# Se dietro Cloudflare Tunnel / nginx sullo stesso host o rete docker:
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TRUSTED_PROXIES=
# Durata del token di accesso (default 24h). Es. 720h = un re-login al mese.
# La revoca (logout, reset password) resta immediata a qualunque durata.
# Massimo consentito: 720h (30 giorni), la retention delle revoche per utente.
# JWT_TTL=720h

# Tetto del body di POST /api/v1/sync, in byte (default 67108864 = 64 MiB).
# SYNC_MAX_BODY_BYTES=67108864

# Primario Turso/libSQL per la modalità embedded replica. Usare libsql:// o
# https://; http:// è accettato solo verso localhost/127.0.0.1/[::1].
# TURSO_SYNC_URL=libsql://example.turso.io
